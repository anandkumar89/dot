ctrl + alt - q 	: /usr/local/opt/yabai/bin/yabai --stop-service 
ctrl + alt - s 	: /usr/local/opt/yabai/bin/yabai --start-service 


# when bsp layout! 
# shift + alt - m : yabai -m window --toggle zoom-fullscreen
# shift + alt - e : yabai -m space --balance
# alt - j 		  : yabai -m window --focus south
# alt - k 		  : yabai -m window --focus north
# alt - h 		  : yabai -m window --focus west
# alt - l 		  : yabai -m window --focus east
# shift + alt - j : yabai -m window --warp south
# shift + alt - k : yabai -m window --warp north
# shift + alt - h : yabai -m window --warp west
# shift + alt - l : yabai -m window --warp east

# moving focus of window from display 1-2 (usually two displays)
alt - n : yabai -m display --focus 2
alt - p : yabai -m display --focus 1

# focusing between spaces 
alt - 1 		: yabai -m space --focus 1
alt - 2 		: yabai -m space --focus 2
alt - 3 		: yabai -m space --focus 3
alt - 4 		: yabai -m space --focus 4
alt - 5 		: yabai -m space --focus 5
shift + alt - 1 : yabai -m window --space 1; yabai -m space --focus 1
shift + alt - 2 : yabai -m window --space 2; yabai -m space --focus 2
shift + alt - 3 : yabai -m window --space 3; yabai -m space --focus 3
shift + alt - 4 : yabai -m window --space 4; yabai -m space --focus 4
shift + alt - 5 : yabai -m window --space 5; yabai -m space --focus 5
shift + alt - 6 : yabai -m window --space 6; yabai -m space --focus 6

# different resizing
alt - z 		: yabai -m window --grid 1:1:0:0:1:1
shift + alt - j : yabai -m window --grid 1:2:0:0:1:1
shift + alt - k	: yabai -m window --grid 1:2:1:0:2:1
alt - j 		: yabai -m window --move rel:0:20
alt - k 		: yabai -m window --move rel:0:-20
alt - h 		: yabai -m window --move rel:-20:0
alt - l 		: yabai -m window --move rel:20:0
alt - c 		: yabai -m window --grid 30:30:5:5:20:20
alt - w 		: yabai -m window --resize top_left:0:-30
alt - a 		: yabai -m window --resize top_left:-30:0
alt - d 		: yabai -m window --resize bottom_right:+30:0
alt - s 		: yabai -m window --resize bottom_right:0:+30
shift + alt - w : yabai -m window --resize top_left:0:+30
shift + alt - a : yabai -m window --resize top_left:+30:0
shift + alt - d : yabai -m window --resize bottom_right:-30:0
shift + alt - s : yabai -m window --resize bottom_right:0:-30

shift + ctrl - s : yabai -m window --insert stack
shift + ctrl - f : yabai -m window --toggle float | yabai -m window --grid 30:30:5:5:20:20 
shift + alt + ctrl - f : yabai -m space --layout float
shift + alt + ctrl - s : yabai -m space --layout stack
shift + alt + ctrl - b : yabai -m space --layout bsp

