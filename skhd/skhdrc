shift + alt - m : yabai -m window --toggle zoom-fullscreen
shift + alt - e : yabai -m space --balance

ctrl + alt - j : yabai -m window --warp south
ctrl + alt - k : yabai -m window --warp north
ctrl + alt - h : yabai -m window --warp west
ctrl + alt - l : yabai -m window --warp east

ctrl + alt - q : /usr/local/opt/yabai/bin/yabai --stop-service 
ctrl + alt - s : /usr/local/opt/yabai/bin/yabai --start-service 

# moving focus of window from display 1-2 (usually two displays)
alt - n : yabai -m display --focus 2
alt - p : yabai -m display --focus 1
alt - j : yabai -m window  --focus stack.next
alt - k : yabai -m window  --focus stack.prev

alt + shift - n : yabai -m window --display 2
alt + shift - p : yabai -m window --display 1

alt - z : yabai -m window --grid 1:1:0:0:1:1
alt - h : yabai -m window --grid 1:2:0:0:1:1
alt - l : yabai -m window --grid 1:2:1:0:2:1
alt - c : yabai -m window --grid 30:30:5:5:20:20
shift + alt - w : yabai -m window --resize top_left:0:+50
shift + alt - a : yabai -m window --resize top_left:+50:0
shift + alt - d : yabai -m window --resize bottom_right:-50:0
shift + alt - s : yabai -m window --resize bottom_right:0:-50
alt - w : yabai -m window --resize top_left:0:-50
alt - a : yabai -m window --resize top_left:-50:0
alt - d : yabai -m window --resize bottom_right:50:0
alt - s : yabai -m window --resize bottom_right:0:50

#alt + t : yabai -m window --focus "$(yabai -m query --windows | jq -re "sort_by(.display, .space, .frame.x, .frame.y, .id) | map(select(.\"is-visible\" == true and .role != \"AXUnknown\")) | nth(index(map(select(.\"has-focus\" == true))) - 1).id")" &> /dev/null


alt - tab : [ $(yabai -m query --windows --space | jq -re "map(select(.\"has-focus\" == true)) | length != 0") = true ] && yabai -m window --focus "$(yabai -m query --windows --space | jq -re "[sort_by(.id, .frame) | reverse | .[] | select(.role == \"AXWindow\" and .subrole == \"AXStandardWindow\") | .id] | nth(index($(yabai -m query --windows --window | jq -re ".id")) - 1)")" ||  yabai -m window --focus "$(yabai -m query --spaces --space | jq -re ".windows[0]?")" &> /dev/null


shift + alt + ctrl - s : yabai -m space --layout stack
shift + alt + ctrl - f : yabai -m space --layout float
shift + alt + ctrl - b : yabai -m space --layout bsp

